# Copy to .dev.vars for `pnpm dev`; these override the production vars in wrangler.jsonc.
APP_KEY=local-dev-key-change-me
APP_URL=http://localhost:8787
FRONTEND_URL=http://localhost:3000
DEMO_MODE=false
MAIL_DRIVER=log

