APP_NAME=PHive
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Where the Next.js frontend runs. Used for CORS, verification links and password
# reset links. Comma-separate to allow more than one origin (e.g. preview deploys).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=phive
DB_USERNAME=postgres
DB_PASSWORD=
# Managed providers usually hand you a single connection string instead — set
# DB_URL and leave the fields above empty.
# DB_URL=postgres://user:pass@host:5432/phive?sslmode=require

# How long an issued API token stays valid, in minutes. Empty = never expires.
SANCTUM_TOKEN_EXPIRATION=

# API-only app: resolve users from bearer tokens, never from a session cookie.
# This is what lets public endpoints personalise themselves when a token happens
# to be present, without rejecting anonymous callers.
AUTH_GUARD=sanctum

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@phive.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Realtime. `php artisan reverb:install` fills these in on a fresh install; the same
# app key goes into the frontend as NEXT_PUBLIC_REVERB_APP_KEY. Set
# BROADCAST_CONNECTION=log to turn realtime off — messaging still works, it just
# does not push.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Performance. Octane keeps the framework booted between requests via FrankenPHP.
# `php artisan serve` still works for day-to-day development.
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# Monitoring. Get a token from https://nightwatch.laravel.com, then run the agent
# alongside the app (`php artisan nightwatch:agent`). Without a token Nightwatch
# stays off and the app is unaffected.
NIGHTWATCH_TOKEN=
NIGHTWATCH_ENABLED=false
