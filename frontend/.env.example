# Where the Laravel API lives. Read on the server at request time and handed to the
# browser through the provider, so one built artifact stays configurable per
# environment. Public reads (projects, profiles, leaderboards) go straight from the
# browser to this origin, so it has to be reachable from a visitor's network — and the
# API's FRONTEND_URL has to name this site, or CORS will refuse the call.
#
# Authenticated calls do not use it. They stay on the server, where the bearer token
# lives in an httpOnly cookie the browser cannot read.
API_URL=http://localhost:8000

# What to do when the API cannot be reached.
#
#   auto   (default) serve sample data on a transport failure or 5xx, and a banner
#          saying so. A deployment whose backend is not up yet stays browsable, and
#          starts serving real data by itself once the API answers.
#   always force sample data and never call the API — handy for UI work offline.
#   never  let the error through, for an environment where a broken backend should be
#          loud rather than papered over.
#
# A 4xx is always passed through in every mode: a missing project has to stay a 404
# rather than turning into an invented one.
DEMO_DATA=auto

# Realtime (optional). Leave the key blank and the app simply does not push —
# threads still load on request. Values come from backend/.env after
# `php artisan reverb:install`.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Which social buttons to show, comma separated: google,apple. Must match what the
# API actually has credentials for.
SOCIAL_PROVIDERS=
